package leoproxy.node;

import inet.applications.contract.IApp;

//
// HTTP client population of one client group.
//
// One instance emulates 'numUsers' concurrent users ("concurrent flows").
// Each user owns up to maxConnectionsPerUser persistent HTTP/1.1 connections
// to its forward proxy (no pipelining).
//
// Request model
//  - videoMode = "irm": requests are generated by a Poisson
//    process with rate requestRate per user (Independent Reference Model).
//    Each request is a web object (probability = web fraction of the
//    workload: 1 for web, 0 for video, mixedWebFraction for mixed) drawn by
//    Zipf rank, or the next segment of the user's current video title (title
//    drawn by Zipf rank). The representation of a segment is selected by the
//    throughput-based ABR.
//  - videoMode = "dash": every user is a DASH player that fetches
//    the segments of a Zipf-selected title sequentially, keeps a playback
//    buffer (max dashMaxBuffer), starts/resumes playback at dashStartupBuffer,
//    and selects the representation with the (optionally cache-aware) ABR.
//    requestRate is not used in this mode.
//
// Latency: from the moment the request is handed to TCP (first
// byte leaves the client) until the last byte of the response is received.
// If all of a user's connections are busy the request waits in a per-user
// queue (bounded by maxQueuedRequestsPerUser, excess requests are dropped and
// counted); requestTotalTime includes that waiting time.
//
simple HttpClientApp like IApp
{
    parameters:
        int numUsers;
        string connectAddress;                    // forward proxy of this group
        int connectPort = default(8080);
        double startTime @unit(s) = default(0.5s);
        string trafficType @enum("web","video","mixed") = default("mixed");
        double mixedWebFraction = default(0.7);   // 70% web / 30% video by request count
        string videoMode @enum("irm","dash") = default("irm");
        double requestRate = default(5);          // requests per second per user (1, 5, 10)
        int maxConnectionsPerUser = default(6);
        int maxQueuedRequestsPerUser = default(32);
        string popularityModule = default("popularity");   // path from the network (system) module

        // video catalogue / DASH
        int segmentsPerTitle = default(300);
        double segmentDuration @unit(s) = default(4s);
        string videoSegmentSizes = default("1MB 3MB 6MB 9MB");   // used to derive representation bitrates

        // ABR
        int abrWindow = default(5);
        double abrSafetyFactor = default(0.8);
        double abrPanicBuffer @unit(s) = default(5s);
        bool cacheAwareABR = default(false);
        double dashMaxBuffer @unit(s) = default(60s);
        double dashStartupBuffer @unit(s) = default(8s);

        int tracedUser = default(0);              // user whose buffer/quality is recorded as a time series (-1: none)
        double statsInterval @unit(s) = default(1s);

        @display("i=block/app");
        @lifecycleSupport;
        double stopOperationExtraTime @unit(s) = default(-1s);
        double stopOperationTimeout @unit(s) = default(2s);

        @signal[responseTime](type=simtime_t);
        @signal[webResponseTime](type=simtime_t);
        @signal[videoResponseTime](type=simtime_t);
        @signal[hitResponseTime](type=simtime_t);
        @signal[missResponseTime](type=simtime_t);
        @signal[requestTotalTime](type=simtime_t);
        @signal[requestSent](type=long);
        @signal[responseReceived](type=long);
        @signal[requestDropped](type=long);
        @signal[requestFailed](type=long);
        @signal[bodyBytesReceived](type=long);
        @signal[groupThroughput](type=double);
        @signal[throughputPerUser](type=double);
        @signal[meanResponseTimeWindow](type=double);
        @signal[dashQualityLevel](type=long);
        @signal[dashQualitySwitch](type=long);
        @signal[dashOscillation](type=long);
        @signal[dashStallDuration](type=simtime_t);
        @signal[dashBufferLevel](type=double);
        @signal[tracedBufferLevel](type=double);
        @signal[tracedQualityLevel](type=long);

        @statistic[responseTime](title="end-to-end HTTP response time"; source=responseTime; unit=s; record=mean,max,count,histogram,vector?; interpolationmode=none);
        @statistic[webResponseTime](title="response time, web objects"; source=webResponseTime; unit=s; record=mean,count,histogram; interpolationmode=none);
        @statistic[videoResponseTime](title="response time, video segments"; source=videoResponseTime; unit=s; record=mean,count,histogram; interpolationmode=none);
        @statistic[hitResponseTime](title="response time, cache hits"; source=hitResponseTime; unit=s; record=mean,count,histogram; interpolationmode=none);
        @statistic[missResponseTime](title="response time, cache misses"; source=missResponseTime; unit=s; record=mean,count,histogram; interpolationmode=none);
        @statistic[requestTotalTime](title="response time incl. client-side queueing"; source=requestTotalTime; unit=s; record=mean,max; interpolationmode=none);
        @statistic[requestSent](title="requests sent"; source=requestSent; record=count; interpolationmode=none);
        @statistic[responseReceived](title="responses received"; source=responseReceived; record=count; interpolationmode=none);
        @statistic[requestDropped](title="requests dropped at the client (queue full)"; source=requestDropped; record=count; interpolationmode=none);
        @statistic[requestFailed](title="requests failed (connection lost)"; source=requestFailed; record=count; interpolationmode=none);
        @statistic[bodyBytesReceived](title="application payload received"; source=bodyBytesReceived; unit=B; record=sum; interpolationmode=none);
        @statistic[groupThroughput](title="application throughput of the client group"; source=groupThroughput; unit=bps; record=mean,vector; interpolationmode=sample-hold);
        @statistic[throughputPerUser](title="application throughput per concurrent user"; source=throughputPerUser; unit=bps; record=mean,vector; interpolationmode=sample-hold);
        @statistic[meanResponseTimeWindow](title="mean response time per stats interval"; source=meanResponseTimeWindow; unit=s; record=vector; interpolationmode=sample-hold);
        @statistic[dashQualityLevel](title="selected DASH representation"; source=dashQualityLevel; record=mean,histogram; interpolationmode=none);
        @statistic[dashQualitySwitch](title="DASH quality switches"; source=dashQualitySwitch; record=count; interpolationmode=none);
        @statistic[dashOscillation](title="DASH oscillation events (up-switch followed by down-switch within 3 segments)"; source=dashOscillation; record=count,vector; interpolationmode=none);
        @statistic[dashStallDuration](title="playback stall duration"; source=dashStallDuration; unit=s; record=count,sum,mean; interpolationmode=none);
        @statistic[dashBufferLevel](title="playback buffer at segment arrival"; source=dashBufferLevel; unit=s; record=mean,histogram; interpolationmode=none);
        @statistic[tracedBufferLevel](title="playback buffer of traced user"; source=tracedBufferLevel; unit=s; record=vector; interpolationmode=linear);
        @statistic[tracedQualityLevel](title="representation of traced user"; source=tracedQualityLevel; record=vector; interpolationmode=sample-hold);
    gates:
        input socketIn @labels(TcpCommand/up);
        output socketOut @labels(TcpCommand/down);
}
